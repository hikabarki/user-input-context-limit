# token-flow-extender environment configuration (all optional).
# Every value can also be set programmatically via TokenFlowConfig.

# Safety margin applied to the resolved max input (0 < margin <= 1)
TFE_SAFETY_MARGIN=0.85

# Fraction of each window reserved for carry-over state
TFE_CARRY_STATE_RATIO=0.10

# Boundary-context overlap between consecutive windows (duplicate context only)
TFE_OVERLAP_RATIO=0.10

# Conservative fallback when no limit source succeeds
TFE_FALLBACK_MAX_INPUT_TOKENS=8192
TFE_FALLBACK_MAX_OUTPUT_TOKENS=1024

# Path to the hot-reloadable model registry
TFE_REGISTRY_PATH=model_limits.yaml

# Checkpoint storage: sqlite (default) or redis
TFE_STORAGE_BACKEND=sqlite
TFE_DB_PATH=token_flow.db
TFE_REDIS_URL=redis://localhost:6379/0

# Default processing strategy: sequential_refine | map_reduce | hybrid
TFE_STRATEGY=sequential_refine

# Default mode: lossless (default) | selective (explicit opt-in, lossy)
TFE_MODE=lossless

# Network timeouts (seconds)
TFE_PROBE_TIMEOUT=5
TFE_REQUEST_TIMEOUT=600

# Max parallel windows for map_reduce
TFE_MAX_PARALLEL_WINDOWS=4
